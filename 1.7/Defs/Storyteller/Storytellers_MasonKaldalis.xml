          <Misc>0.3</Misc>
          <GiveQuest>0.7</GiveQuest>
          <DiseaseHuman>0.3</DiseaseHuman>
        </categoryWeights>
      </li>
      <li Class="StorytellerCompProperties_Triggered"><incident>StrangerInBlackJoin</incident><delayTicks>180</delayTicks></li>
    </comps>
  </StorytellerDef>
