<?xml version='1.0' encoding='UTF-8'?>
<Defs>
  <ThingDef ParentName="ApparelArmorPowerBase">
    <defName>PMP_BelieverArmor</defName>
    <label>believer armor</label>
    <description>The standard armor of a legion believer. Merely looking at it stirs a strange impulse within us. The technology used in this armor is a complete mystery to us.</description>
    <techLevel>Archotech</techLevel>
    <graphicData><texPath>Things/Apparel/Romulus/BelieverArmor/BelieverArmor</texPath><graphicClass>Graphic_Single</graphicClass><color>(1,1,1)</color></graphicData>
    <colorGenerator IsNull="True"/>
    <generateCommonality>1</generateCommonality>
    <recipeMaker IsNull="True"/>
    <thingSetMakerTags Inherit="false"/>
    <tradeTags Inherit="false"/>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints><Mass>10</Mass><MarketValue>4800</MarketValue><Flammability>0</Flammability>
      <ArmorRating_Sharp>1.35</ArmorRating_Sharp><ArmorRating_Blunt>0.65</ArmorRating_Blunt><ArmorRating_Heat>1</ArmorRating_Heat>
      <Insulation_Cold>60</Insulation_Cold><Insulation_Heat>30</Insulation_Heat><EquipDelay>12</EquipDelay>
    </statBases>
    <equippedStatOffsets Inherit="false"/>
    <apparel>
      <wornGraphicPath>Things/Apparel/Romulus/BelieverArmor/BelieverArmor</wornGraphicPath>
      <tags Inherit="false"><li>PMP_BelieverArmor</li></tags>
      <layers Inherit="false"><li>OnSkin</li><li>Middle</li><li>Shell</li></layers>
    </apparel>
    <modExtensions>
      <li Class="PMP_Persona.Romulus.LegionExtension"><advanced>true</advanced></li>
      <li Class="PMP_Persona.Romulus.SharedApparelBodyGraphic"><bodyType>Male</bodyType></li>
    </modExtensions>
    <smeltProducts><Plasteel>30</Plasteel><Steel>20</Steel></smeltProducts>
  </ThingDef>
  <ThingDef ParentName="ApparelArmorHelmetPowerBase">
    <defName>PMP_BelieverHelmet</defName>
    <label>believer helmet</label>
    <description>The standard helmet of a legion believer. Merely looking at it stirs a strange impulse within us. The technology used in this helmet is a complete mystery to us.</description>
    <techLevel>Archotech</techLevel>
    <graphicData><texPath>Things/Apparel/Romulus/BelieverHelmet/BelieverHelmet</texPath><graphicClass>Graphic_Single</graphicClass><color>(1,1,1)</color></graphicData>
    <colorGenerator IsNull="True"/>
    <generateCommonality>1</generateCommonality>
    <recipeMaker IsNull="True"/>
    <thingSetMakerTags Inherit="false"/>
    <tradeTags Inherit="false"/>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints><Mass>2</Mass><MarketValue>1800</MarketValue><Flammability>0</Flammability>
      <ArmorRating_Sharp>1.35</ArmorRating_Sharp><ArmorRating_Blunt>0.65</ArmorRating_Blunt><ArmorRating_Heat>1</ArmorRating_Heat>
      <Insulation_Cold>8</Insulation_Cold><Insulation_Heat>6</Insulation_Heat><EquipDelay>3</EquipDelay>
    </statBases>
