    <smeltProducts><Plasteel>12</Plasteel><Steel>8</Steel></smeltProducts>
  </ThingDef>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>PMP_BelieverSpearRifle</defName>
    <label>Spearpoint</label>
    <description>A red-and-ivory archotech spindle carried by legion believers. Its inlaid channels project three narrow armor-piercing pulses, while the integral point can deliver a penetrating melee thrust. It uses ordinary projectile and melee damage; training bonuses come from the legion merit system.</description>
    <techLevel>Archotech</techLevel>
    <graphicData><texPath>Things/Equipment/Romulus/BelieverSpearRifle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.5,1.5)</drawSize></graphicData>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints><Mass>2.5</Mass><MarketValue>3200</MarketValue><Flammability>0</Flammability>
      <AccuracyTouch>0.95</AccuracyTouch><AccuracyShort>0.80</AccuracyShort><AccuracyMedium>0.50</AccuracyMedium><AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags><li>PMP_BelieverSpearRifle</li></weaponTags>
    <weaponClasses><li>RangedLight</li></weaponClasses>
    <verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>PMP_BelieverSpearShot</defaultProjectile><warmupTime>0.5</warmupTime><range>19.9</range><burstShotCount>3</burstShotCount><ticksBetweenBurstShots>7</ticksBetweenBurstShots><soundCast>Shot_ChargeRifle</soundCast><soundCastTail>GunTail_Medium</soundCastTail><muzzleFlashScale>1</muzzleFlashScale></li></verbs>
    <tools><li><label>spear point</label><capacities><li>Stab</li></capacities><power>18</power><armorPenetration>1</armorPenetration><cooldownTime>1.8</cooldownTime></li></tools>
    <modExtensions><li Class="PMP_Persona.Romulus.LegionExtension"><advanced>true</advanced></li></modExtensions>
    <recipeMaker IsNull="True"/>
    <smeltProducts><Plasteel>15</Plasteel><Steel>15</Steel></smeltProducts>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>PMP_BelieverSpearShot</defName><label>spear pulse</label>
    <graphicData><texPath>Things/Projectile/Charge_Small</texPath><graphicClass>Graphic_Single</graphicClass><color>(1,0.15,0.12)</color></graphicData>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>25</damageAmountBase><armorPenetrationBase>1.30</armorPenetrationBase><speed>55</speed></projectile>
  </ThingDef>
</Defs>
