<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>PMP_UpgradeSpearpoint</defName>
    <label>upgrade to Spearpoint</label>
    <description>Upgrade one prototype weapon with one archotech armor fragment. Product quality is at least the quality of the consumed prototype.</description>
    <jobString>Upgrading a weapon.</jobString>
    <workerClass>PMP_Persona.Romulus.RecipeWorker_LegionWeaponUpgrade</workerClass>
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <useIngredientsForColor>false</useIngredientsForColor>
    <researchPrerequisite>PMP_SpearpointResearch</researchPrerequisite>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <count>1</count>
        <filter>
          <thingDefs>
            <li>Gun_MachinePistol</li>
          </thingDefs>
        </filter>
      </li>
      <li>
        <count>1</count>
        <filter>
          <thingDefs>
            <li>PMP_ArchotechArmorFragment</li>
          </thingDefs>
        </filter>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Gun_MachinePistol</li>
        <li>PMP_ArchotechArmorFragment</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PMP_BelieverSpearRifle>1</PMP_BelieverSpearRifle>
    </products>
    <modExtensions>
      <li Class="PMP_Persona.Romulus.LegionUpgradeRecipe">
        <prototype>Gun_MachinePistol</prototype>
      </li>
    </modExtensions>
  </RecipeDef>
