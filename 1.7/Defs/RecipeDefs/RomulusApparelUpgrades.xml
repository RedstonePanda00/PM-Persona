<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>PMP_UpgradeLegionShield</defName>
    <label>upgrade to legion heavy shield</label>
    <description>Upgrade one corresponding prototype with 1 archotech armor fragment. Product quality is at least the quality of the consumed prototype.</description>
    <jobString>Upgrading legion apparel.</jobString>
    <workerClass>PMP_Persona.Romulus.RecipeWorker_LegionWeaponUpgrade</workerClass>
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <useIngredientsForColor>false</useIngredientsForColor>
    <researchPrerequisite>PMP_LegionShieldResearch</researchPrerequisite>
    <recipeUsers>
      <li>ElectricSmithy</li>
      <li>FueledSmithy</li>
    </recipeUsers>
    <ingredients>
      <li>
        <count>1</count>
        <filter>
          <thingDefs>
            <li>Apparel_SimpleHelmet</li>
          </thingDefs>
        </filter>
      </li>
      <li>
        <count>1</count>
        <filter>
          <thingDefs>
            <li>PMP_ArchotechArmorFragment</li>
          </thingDefs>
        </filter>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Apparel_SimpleHelmet</li>
        <li>PMP_ArchotechArmorFragment</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PMP_LegionShield>1</PMP_LegionShield>
    </products>
    <modExtensions>
      <li Class="PMP_Persona.Romulus.LegionUpgradeRecipe">
        <prototype>Apparel_SimpleHelmet</prototype>
      </li>
    </modExtensions>
  </RecipeDef>
