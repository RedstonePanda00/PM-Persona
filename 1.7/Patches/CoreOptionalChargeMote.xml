<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Remove the Odyssey charge-mote reference when the DLC is unavailable. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Mote_BeamRepeater_Charge"]</xpath>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef/verbs/li/aimingChargeMote[text()="Mote_BeamRepeater_Charge"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>Defs/ThingDef/verbs/li/aimingChargeMote[text()="Mote_BeamRepeater_Charge"]</xpath>
      </match>
    </nomatch>
  </Operation>
</Patch>
