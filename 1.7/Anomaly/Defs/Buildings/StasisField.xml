<?xml version="1.0" encoding="utf-8"?>
<Defs>
 <ThingDef ParentName="BuildingBase">
  <defName>PMP_StasisField</defName><label>stasis field</label>
  <description>A containment platform that arrests time within a sealed volume. Its captive remains suspended while investigators study it from outside. When the field loses power, the captive returns to ordinary space.</description>
  <thingClass>PMP.Anomaly.Building_StasisField</thingClass>
  <tickerType>Normal</tickerType><drawerType>RealtimeOnly</drawerType>
  <graphicData><texPath>Things/Building/StasisField/Base</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(3,3)</drawSize></graphicData>
  <size>(3,3)</size><rotatable>false</rotatable><passability>PassThroughOnly</passability><pathCost>30</pathCost><fillPercent>0.4</fillPercent>
  <altitudeLayer>Building</altitudeLayer><designationCategory>Anomaly</designationCategory><uiOrder>115</uiOrder>
  <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded><constructionSkillPrerequisite>10</constructionSkillPrerequisite>
  <canOverlapZones>false</canOverlapZones><containedPawnsSelectable>true</containedPawnsSelectable>
  <statBases><MaxHitPoints>400</MaxHitPoints><WorkToBuild>6000</WorkToBuild><Flammability>0</Flammability><Beauty>8</Beauty></statBases>
  <costList><Plasteel>100</Plasteel><ComponentSpacer>3</ComponentSpacer></costList>
  <researchPrerequisites><li>PM_HigherDimensionalSpacetime</li><li>EntityContainment</li></researchPrerequisites>
  <comps>
   <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>1000</basePowerConsumption></li>
   <li Class="CompProperties_Flickable"/>
   <li Class="ProtossMech.CompProperties_ProtossBuilding"/>
   <li Class="ProtossMech.CompProperties_ProtossMechShield"><energyMax>400</energyMax><energyGainPerTick>0.2</energyGainPerTick><ticksToBeginRecharge>600</ticksToBeginRecharge><minDrawSize>2</minDrawSize><maxDrawSize>2.5</maxDrawSize></li>
  </comps>
  <building><isEdifice>false</isEdifice><isPlayerEjectable>false</isPlayerEjectable></building>
  <constructEffect>ConstructMetal</constructEffect><leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
 </ThingDef>
 <JobDef><defName>PMP_CarryToStasis</defName><driverClass>PMP.Anomaly.JobDriver_CarryToStasis</driverClass><reportString>securing TargetB in the stasis field.</reportString><casualInterruptible>false</casualInterruptible></JobDef>
 <JobDef><defName>PMP_StudyStasis</defName><driverClass>PMP.Anomaly.JobDriver_StudyStasis</driverClass><reportString>studying the suspended entity.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
 <WorkGiverDef><defName>PMP_CarryToStasis</defName><label>contain entities in stasis</label><giverClass>PMP.Anomaly.WorkGiver_CarryToStasis</giverClass><workType>Hauling</workType><priorityInType>95</priorityInType><verb>contain</verb><gerund>containing</gerund></WorkGiverDef>
 <WorkGiverDef><defName>PMP_StudyStasis</defName><label>study suspended entities</label><giverClass>PMP.Anomaly.WorkGiver_StudyStasis</giverClass><workType>DarkStudy</workType><priorityInType>110</priorityInType><verb>study</verb><gerund>studying</gerund><requiredCapacities><li>Manipulation</li></requiredCapacities></WorkGiverDef>
</Defs>
